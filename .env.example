# Paper/shadow is the default. Live trading requires BOTH flags below.
LIVE=0

# Signing key for `live` and `cancel`. Never commit a real key.
# This may be:
#   - the master wallet key, OR
#   - an approved Hyperliquid API / agent key (same as Entropy's IndexedDB agent).
# The bot never prints this value.
HYPERLIQUID_PRIVATE_KEY=

# Master address that holds isolated HIP-3 positions and open orders.
# Required when HYPERLIQUID_PRIVATE_KEY is an agent/API wallet (address != master).
# Official SDK path: Exchange(wallet=agent, account_address=master, vault_address=None).
# vaultAddress is ONLY for vault/subaccount trading — do not put the master there.
# If unset, the address derived from the private key is used (key IS the master).
HYPERLIQUID_ACCOUNT=

# Case-sensitive HIP-3 names on EntropyIO only. Do not use xyz: or vntl:.
# Current ops: SNDK only (default). ANTH is still supported: COINS=io:ANTH,io:SNDK
COINS=io:SNDK

# Coins that only open quotes in NYSE regular hours (Mon–Fri 09:30–16:00 NY,
# holidays / 13:00 early closes honored). Outside RTH they only flatten.
# Set empty (RTH_ONLY_COINS=) to quote 24/7.
RTH_ONLY_COINS=io:SNDK

# Per-coin seconds between price reprices of a live rest. Book ticks do not
# reprice faster than this. Stage changes (fill → flatten ladder) and the
# ≥15s IOC take are not gated.
MIN_REPLACE_S=12

# Keep a resting quote while it is within this many ticks of the target
# (saves cancel+place and keeps queue priority).
REQUOTE_TOLERANCE_TICKS=1

# Refresh an untouched flat quote after this many seconds. 0 disables.
STALE_QUOTE_S=120

# Account-wide dead-man horizon (scheduleCancel now+N, renewed at N/3 left).
# Longer = fewer writes; a hard kill leaves orders up to N seconds. Min 10.
DEADMAN_AHEAD_S=60

# Flatten IOC crosses this many ticks past the near touch.
TAKE_SLIPPAGE_TICKS=2

# No opening quotes while |book mid - oraclePx| > N bp (WS activeAssetCtx). 0 disables.
ORACLE_MAX_DEV_BPS=50

# |position| notional that skips the ALO ladder and goes straight to IOC.
# Unset = 3 x QUOTE_NOTIONAL_USD.
MAX_POSITION_USD=

# Stop opening quotes for the rest of the UTC day once realized net PnL
# (closedPnl - fee from userFills) is below -N USD. 0 disables.
MAX_DAILY_LOSS_USD=0

# On stop (Ctrl-C / SIGTERM / --seconds end): opening quotes off, then
# reduce-only IOC every position flat for up to N seconds, cancel, and verify
# with a fresh clearinghouseState. Exit code 3 + ERROR log if not flat.
# 0 = cancel only (position is left open and reported). Second Ctrl-C skips the wait.
STOP_FLATTEN_S=30

# Stop new opening quotes when userRateLimit headroom (cap - used) < N.
# Reprices slow down 3x below 4N. Cancels / flatten always go out.
REQUEST_BUDGET_RESERVE=500

# Quote size in USDC notional per side. Live default is this value (~$50), min $10.
# Sizes are rounded up one lot when flooring would land under the exchange's $10 minimum.
QUOTE_NOTIONAL_USD=50

# Legacy paper knob. Live MM ignores this and uses userscript 1.6.1 join/improve.
QUOTE_OFFSET_TICKS=2

# Isolated leverage cap. Always min(this, market max). Below ANTH's max of 3.
MAX_LEVERAGE=2

# Hyperliquid volume fee tier. Default 4 = 14d weighted volume > $500M (taker 0.028% / maker 0%).
FEE_TIER=4

# Entropy Partner program: https://docs.entropy.io/about-entropy/referrals.md
# Percentages apply only to Entropy's deployer share (50% when deployerFeeScale>=1).
# Card: 返佣 200% / 优惠 100% / TIER 4. 优惠 is invitee reward, not 100% off the full HL fee.
ENTROPY_TIER=4
ENTROPY_SELF_REBATE=2.0
ENTROPY_REFERRAL_REWARD=1.0
# Leave 0 so 优惠/referred-user benefit is NOT applied to this bot's own fills.
ENTROPY_REFERRED_USER_BENEFIT=0

# Optional Hyperliquid-side taker multiplier: gross_taker * (1 - REFERRAL_DISCOUNT).
# This is not Entropy 优惠. Leave 0 unless you have a measured HL referral discount.
REFERRAL_DISCOUNT=0

# Optional ALO maker-share rebate in basis points of notional (1 bp = 0.01%).
# Official tiers: 0.1 / 0.2 / 0.3 bp → -0.001% / -0.002% / -0.003%.
# Unset = assume maker fee 0 (tier 4 protocol maker is already 0).
MAKER_REBATE_BPS=

# Official Hyperliquid endpoints only.
HYPERLIQUID_API_URL=https://api.hyperliquid.xyz
HYPERLIQUID_WS_URL=wss://api.hyperliquid.xyz/ws
